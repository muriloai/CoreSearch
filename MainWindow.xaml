<Window x:Class="CoreSearch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:CoreSearch.ViewModels"
        mc:Ignorable="d"
        Title="Core Search"
        Icon="app.ico"
        Height="700" Width="1000"
        MinHeight="550" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA"
        FontFamily="Segoe UI, Segoe UI Variable, system-ui, sans-serif"
        FontSize="13">

    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Botão Primário (Buscar) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#18181B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#27272A" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E4E4E7" />
                    <Setter Property="Foreground" Value="#A1A1AA" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botão Secundário / Outline (Selecionar Pasta / Limpar) -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#27272A" />
            <Setter Property="BorderBrush" Value="#E4E4E7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F4F4F5" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FAFAFA" />
                    <Setter Property="Foreground" Value="#D4D4D8" />
                    <Setter Property="BorderBrush" Value="#F4F4F5" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botão Cancelar -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EF4444" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FEE2E2" />
                    <Setter Property="Foreground" Value="#FCA5A5" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo de Input -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#E4E4E7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#18181B" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Checkbox Estilizado -->
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#52525B" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Inputs Card -->
            <RowDefinition Height="Auto" />
            <!-- DataGrid -->
            <RowDefinition Height="*" />
            <!-- Footer Status -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER MINIMALISTA COM LOGO DA APLICAÇÃO -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Background="#18181B" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                <Path Data="M 15.5,14 h -0.79 l -0.28,-0.27 C 15.41,12.59 16,11.11 16,9.5 C 16,5.91 13.09,3 9.5,3 C 5.91,3 3,5.91 3,9.5 C 3,13.09 5.91,16 9.5,16 c 1.61,0 3.09,-0.59 4.23,-1.57 l 0.27,0.28 v 0.79 l 5,4.99 L 20.49,19 l -4.99,-5 Z M 9.5,14 C 7.01,14 5,11.99 5,9.5 C 5,7.01 7.01,5 9.5,5 C 11.99,5 14,7.01 14,9.5 C 14,11.99 11.99,14 9.5,14 Z"
                      Fill="#FFFFFF" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Core Search" FontSize="16" FontWeight="SemiBold" Foreground="#18181B" VerticalAlignment="Center" />
        </StackPanel>

        <!-- PAINEL DE BUSCA -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,16"
                BorderBrush="#E4E4E7" BorderThickness="1">
            <StackPanel>
                <!-- Linha 1: Pasta Alvo -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Pasta Alvo" Foreground="#71717A" VerticalAlignment="Center" FontWeight="Medium" />
                    <TextBox Grid.Column="1" Text="{Binding RootDirectory, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,0" IsEnabled="{Binding CanSearch}" />
                    <Button Grid.Column="2" Content="Procurar..." Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding SelectFolderCommand}" />
                </Grid>

                <!-- Linha 2: Termo de Busca & Extensões -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Texto" Foreground="#71717A" VerticalAlignment="Center" FontWeight="Medium" />
                    <TextBox Grid.Column="1" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,12,0" IsEnabled="{Binding CanSearch}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <TextBlock Grid.Column="2" Text="Filtro" Foreground="#71717A" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="0,0,8,0" FontWeight="Medium" />
                    <TextBox Grid.Column="3" Text="{Binding ExtensionFilter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Ex: *.* | *.cs;*.txt" IsEnabled="{Binding CanSearch}" />
                </Grid>

                <!-- Linha 3: Opções & Ações -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="Maiúsculas/Minúsculas" IsChecked="{Binding MatchCase}" IsEnabled="{Binding CanSearch}" />
                        <CheckBox Content="Palavra inteira" IsChecked="{Binding MatchWholeWord}" IsEnabled="{Binding CanSearch}" />
                        <CheckBox Content="Subpastas" IsChecked="{Binding IncludeSubdirectories}" IsEnabled="{Binding CanSearch}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Limpar" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ClearCommand}" Margin="0,0,8,0" />
                        <Button Content="Cancelar" Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding CancelCommand}" Margin="0,0,8,0" Width="75" />
                        <Button Content="Buscar" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SearchCommand}" Width="85" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- RESULTADOS DATAGRID -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="8"
                BorderBrush="#E4E4E7" BorderThickness="1" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Results}"
                      SelectedItem="{Binding SelectedResult}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F4F4F5"
                      RowBackground="#FFFFFF"
                      AlternatingRowBackground="#FAFAFA"
                      BorderThickness="0"
                      Background="#FFFFFF"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Abrir Arquivo" Command="{Binding OpenFileCommand}" />
                        <MenuItem Header="Abrir Pasta no Explorer" Command="{Binding OpenFolderCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FAFAFA" />
                        <Setter Property="Foreground" Value="#71717A" />
                        <Setter Property="FontWeight" Value="Medium" />
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="#E4E4E7" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="30" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F4F4F5" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E4E4E7" />
                                <Setter Property="Foreground" Value="#18181B" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Arquivo" Binding="{Binding FileName}" Width="180" FontWeight="Medium" />
                    <DataGridTextColumn Header="Linha" Binding="{Binding LineNumber}" Width="60" />
                    <DataGridTextColumn Header="Trecho" Binding="{Binding LineContent}" Width="3*" />
                    <DataGridTextColumn Header="Caminho" Binding="{Binding DirectoryPath}" Width="2*" Foreground="#A1A1AA" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- FOOTER STATUS -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Barra de Progresso Fina -->
            <ProgressBar Grid.Row="0" Height="2" Margin="0,0,0,8"
                         IsIndeterminate="{Binding IsSearching}"
                         Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"
                         Foreground="#18181B" Background="#E4E4E7" BorderThickness="0" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#71717A" VerticalAlignment="Center" FontSize="12" />

                <TextBlock Grid.Column="1" Foreground="#71717A" VerticalAlignment="Center" FontSize="12">
                    <Run Text="Resultados: " />
                    <Run Text="{Binding ResultCount}" FontWeight="SemiBold" Foreground="#18181B" />
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</Window>
